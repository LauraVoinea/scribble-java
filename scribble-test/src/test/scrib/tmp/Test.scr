                cancel() from Bob to Seller;
                ack() from Seller to Bob;
          }
          } () or Bob -> Seller(){
              timeout() from Seller to Bob;
          }
  }() or Alice -> Seller() {
      notAvailable() from Seller to Alice;
      notAvailable() from Seller to Bob;
  }

}
//*/












