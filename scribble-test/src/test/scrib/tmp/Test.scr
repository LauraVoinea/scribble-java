module tmp.Test;


// Sec. 2 Fig. 1 -- Exception, Interrupt, etc. similar
global protocol Timeout(role A, role B, role C) {
    mixed { // "Left-hand" side (LHS)
        a1() from A to B;
        a2() from B to C;
        a5() from B to A;
        a6() from A to C;
    } or A -> B { // "Right-hand" side (RHS)
        To() from B to A;
        To() from B to C;
    }
}
