module Progress;


//* // Sec. 3.4 (7) l.538 -- q � p : 𝑎.end ⊲𝑐:p p � q : 𝑏.end
global protocol Progress(role p, role q) {
    mixed {
        a() from q to p;
        //a1() from p to q;  // !!! left committing -- XXX progress ?  // cf. Ex. 3.7 ?
    } or q->p {
        b() from p to q;
    }
}
//*/
