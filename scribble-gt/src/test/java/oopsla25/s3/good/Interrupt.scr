module Intro;


//* // Sec. 1 l.62 (𝐴 → 𝐵 :𝑎1 . 𝐵 → 𝐶 :𝑎2 . ...) + (𝐵 → 𝐴 :𝑎3 . 𝐵 → 𝐶 :𝑎4 . ...)
global protocol Proto1(role A, role B, role C) {
    mixed {
        a1() from A to B;
        a2() from B to C;
        a5() from B to A;  // !!! left committing
    } or A -> B {
        a3() from B to A;
        a4() from B to C;
    }
}
//*/


/* // Sec. 3.1 (4) l.437 -- p � q : 𝑎. q � r : 𝑐. G1 ⊲ q � p : 𝑏. q � r : 𝑐. 2
global protocol WF(role p, role q, role r) {
    mixed {
        a() from p to q;
        c() from q to r;
        // 1() from r to q;
        // 2() from q to p;
    } () or p->q () {
        b() from q to p;
        c() from q to r;  // !!! cf. indifferent
        // 3() from p to r;  // n.b. reverse dir and different peer
    }
}
//*/

