    mixed {
        c() from q to p;
        rec t {
            a() from q to p;
            continue t;
        }
    } () or q->p () {
        b() from p to q;
    }
}
//*/

/* Ex. 3.7 ;.606 -- ✓ q � r : 𝑐. 𝜇t.(q � p : 𝑎. t) ⊲ r � p : 𝑏. r � p : 𝑏. end
global protocol Ex3_7c(role p, role q, role r) {
    mixed {
        c() from q to r;
        rec t {  // !!! XXX EFSM (state kind) for p: mu t.q&{a().t} ▷1 r&{b().end}
            a() from q to p;
            continue t;
        }
    } () or q->r () {
        b() from r to q;
        b() from r to p;
    }
}
//*/

/* Ex. 3.8 l.615 -- q � p : 𝑐. 𝜇t.(q � p : {𝑎. t, 𝑑. p � q : 𝑒. end}) ⊲ p � q : 𝑏. end -- cf. Fig. 7
global protocol Ex3_8(role p, role q) {
    mixed {
        c() from q to p;
        rec t {
            choice at q {
                a() from q to p;  // !!! testing relaxed synctactic eventual deps (filter diverging choice cases)
                continue t;
            } or {
                d() from q to p;
                e() from p to q;
            }
        }
    } () or q->p () {
        b() from p to q;
    }
}
//*/

/* // Sec. 3.4 (8) l.625 -- p � q : {𝑎. q � r : {𝑐.end}, 𝑏. q � p : {𝑐.end}}
global protocol balance(role p, role q, role r) {
    choice at p {
        a() from p to q;
        c() from q to r;  // Testing balance ... though actual safety comes from projection/merge
    } or {
        b() from p to q;
        c() from q to p;
    }
}
//*/


