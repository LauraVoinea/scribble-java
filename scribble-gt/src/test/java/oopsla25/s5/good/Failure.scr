module Failure;

//* // Fig. 7
data <java> "java.lang.String" from "rt.jar" as Data;

global protocol FailureHandling(role M, role W, role FD) {
    init(Data) from M to W;
    rec X {
        mixed { // LHS
            HB() from W to FD; OK() from FD to M; result(Data) from W to M; more(Data) from M to W;
            continue X;
        } or W @failed -> FD { // RHS
            Timeout() from FD to W; //@'failed W'  // TODO handle keyword with failure-prone role, subclass of mixed
            Crash() from FD to M;
        }
    }
}
//*/
