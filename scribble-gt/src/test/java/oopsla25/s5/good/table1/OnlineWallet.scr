// https://github.com/LauraVoinea/scribble-java/blob/gt-artifact/scribble-gt-demos/classics/OnlineWallet.scr

module OnlineWallet;

// Roles:
//   S: Server – Handles account information and payment processing.
//   C: Client – Initiates login and initiates payment or quit.
//   A: Authenticator – Verifies login and directs protocol branching.

global protocol OnlineWallet(role S, role C, role A) {
    login() from C to A;
        choice at A {
            login_success () from A to C;
            login_accepted () from A to S;
            rec  LOOP {
                account() from S to C;
                mixed{
                    choice  at C {
                        pay() from C to S;
                        confirmation() from S to C;
                        keep_alive() from C to A;
                        continue  LOOP;
                    } or {
                        quit() from C to S;
                        quit_ack() from S to C;
                        end_session() from C to A;
                    }
                } () or C->S() {
                         timeout() from S to C;
                         timeout() from S to A;
                         }
            }
        } or {
            login_failed() from A to C;
            auth_fail() from A to S;
        }
}