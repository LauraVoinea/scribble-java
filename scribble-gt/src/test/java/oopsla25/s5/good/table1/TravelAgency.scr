// https://github.com/LauraVoinea/scribble-java/blob/gt-artifact/scribble-gt-demos/classics/TravelAgency.scr

module TravelAgency;


global protocol TravelAgency(role Client, role Agency, role Supplier)
{
	rec Loop {
		booking_request() from Client to Agency;
		price_quote() from Agency to Client;
		mixed{
            choice at Client {
                accept_offer() from Client to Agency;
                accept_confirmation() from Agency to Client; //addition for left commiting
                provide_address() from Client to Supplier;
                confirm_date() from Supplier to Client;
            } or {
                reject_offer() from Client to Agency;
                reject_confirmation() from Agency to Client; //addition for left commiting
                cancel_booking() from Client to Supplier;
            } or {
                resubmit_request() from Client to Agency;
                repeat_confirmation() from Agency to Client;//addition for left commiting
                resubmitting() from Client to Supplier;
                continue Loop;
            }
		} or Client -> Agency {
               price_adjustment() from Agency to Client;
               cancel_agency() from Client to Agency;
               cancel_supplier() from Client to Supplier;
		}
	}
}