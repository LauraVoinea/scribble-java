// https://github.com/LauraVoinea/scribble-java/blob/gt-artifact/scribble-gt-demos/classics/DistributedLogging.scr

module DistributedLogging;

// example from  https://arxiv.org/pdf/2204.13464.pdf
/*
global protocol DistributedLogging(role Controller, role Logs){
    Start() from Controller to Logs;
    rec Loop {
        choice at Logs{
            Success() from Logs to Controller;
            continue Loop;
        } or {
            Failure() from Logs to Controller;
            choice at Controller {
                Restart() from Controller to Logs;
                continue Loop;
            } or {
                Stop() from Controller to Logs;
            }
        }
    }
}
*/

global protocol DistributedLogging(role Controller, role Logs){
    start_logging() from Controller to Logs;
    rec Loop {
        mixed{
            choice at Logs{
                log_success() from Logs to Controller;
                success_ack() from Controller to Logs; // extra for left commiting
                continue Loop;
            } or {
                log_failure() from Logs to Controller;
                choice at Controller {
                    restart_logging() from Controller to Logs;
                    continue Loop;
                } or {
                    stop_logging() from Controller to Logs;
                }
            }
        } or Logs -> Controller {
            timeout() from Controller to Logs;
            ack() from Logs to Controller;
            restart() from Controller to Logs;
            continue Loop;
        }
    }
}