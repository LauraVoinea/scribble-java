module Timeout;

global protocol Timeout(role A, role B, role C) {
    mixed {  // "Left-hand" side (LHS)
        a1() from A to B;
        a2() from A to C;
        a3() from B to C;
        a4() from B to A;
        a5() from C to A;
    } or A -> B {  // "Right-hand" side (RHS)
        TOa() from B to A;
        TOc() from B to C;
    }
}