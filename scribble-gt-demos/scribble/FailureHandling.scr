module FailureHandling;
data <java> "java.lang.String" from "rt.jar" as Payload;


global protocol FailureHandling(role M, role W, role FD) {
    init(Payload) from M to W;
    rec X {
        mixed { // LHS
            HB() from W to FD;
            OK() from FD to M;
            result(Payload) from W to M;
            more(Payload) from M to W;
            continue X;
        } or W @failed -> FD { // RHS
            Timeout() from FD to W; //@'failed W'
            Crash() from FD to M;
        }
    }
}